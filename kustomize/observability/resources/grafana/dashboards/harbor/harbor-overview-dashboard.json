{
  "title": "Harbor / Overview",
  "uid": "harbor-overview",
  "tags": ["harbor", "registry"],
  "timezone": "browser",
  "schemaVersion": 39,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "current": {
          "selected": true,
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 0,
        "includeAll": false,
        "label": "Datasource",
        "multi": false,
        "name": "datasource",
        "options": [],
        "query": "prometheus",
        "refresh": 1,
        "regex": "",
        "skipUrlSync": false,
        "type": "datasource"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Harbor",
      "description": "harbor_health -- the exporter's own gauge, sourced from Harbor's /api/v2.0/health endpoint.",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "$${datasource}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$${datasource}" },
          "expr": "max(harbor_health)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "DOWN", "color": "red" },
                "1": { "text": "UP", "color": "green" }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Total Projects",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "$${datasource}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$${datasource}" },
          "expr": "max(harbor_statistics_total_project_amount)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total Repositories",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "$${datasource}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$${datasource}" },
          "expr": "max(harbor_statistics_total_repo_amount)",
          "refId": "A"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Storage Used",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "prometheus", "uid": "$${datasource}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$${datasource}" },
          "expr": "max(harbor_statistics_total_storage_consumption)",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        }
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Component health",
      "description": "harbor_up{component} -- one series per component /api/v2.0/health enumerates (core, portal, jobservice, registry, registryctl, database, redis, trivy when scanning is on).",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "$${datasource}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$${datasource}" },
          "expr": "harbor_up",
          "legendFormat": "{{component}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "stepAfter": true
          },
          "min": 0,
          "max": 1
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Projects: public vs private",
      "gridPos": { "x": 0, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "$${datasource}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$${datasource}" },
          "expr": "harbor_statistics_public_project_amount",
          "legendFormat": "public",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$${datasource}" },
          "expr": "harbor_statistics_private_project_amount",
          "legendFormat": "private",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Repositories: public vs private",
      "gridPos": { "x": 12, "y": 12, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "$${datasource}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$${datasource}" },
          "expr": "harbor_statistics_public_repo_amount",
          "legendFormat": "public",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "$${datasource}" },
          "expr": "harbor_statistics_private_repo_amount",
          "legendFormat": "private",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Jobservice queue size by type",
      "description": "harbor_task_queue_size{type} -- pending tasks per job type (GC, replication, retention, webhook, ...).",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "$${datasource}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$${datasource}" },
          "expr": "harbor_task_queue_size",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Jobservice queue latency by type",
      "description": "harbor_task_queue_latency{type} -- how long ago the next job to be processed was enqueued.",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "$${datasource}" },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "$${datasource}" },
          "expr": "harbor_task_queue_latency",
          "legendFormat": "{{type}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        }
      }
    }
  ]
}
